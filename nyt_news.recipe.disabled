#!/usr/bin/env python
import os
import re

from calibre.web.feeds.news import BasicNewsRecipe

use_wayback_machine = False


class NytFeeds(BasicNewsRecipe):
    title = 'NYT News'
    __author__ = 'unkn0wn'
    description = (
        'The New York Times is dedicated to helping people understand the world through '
        'on-the-ground, expert and deeply reported independent journalism. Feeds based recipe.'
    )
    oldest_article = 1
    encoding = 'utf-8'
    # Prefer embedded RSS content to reduce article fetch failures on NYT pages.
    use_embedded_content = False
    max_articles_per_feed = 8
    simultaneous_downloads = 1
    delay = 2
    language = 'en_US'
    remove_empty_feeds = True
    resolve_internal_links = True
    ignore_duplicate_articles = {'title', 'url'}
    masthead_url = 'https://static01.nytimes.com/newsgraphics/2015-12-23-masthead-2016/b15c3d81d3d7b59065fff9a3f3afe85aa2e2dff5/_assets/nyt-logo.png'
    needs_subscription = True
    username = os.environ.get('NYT_USERNAME', '').strip()
    password = os.environ.get('NYT_PASSWORD', '').strip()

    # https://www.nytimes.com/rss
    # https://developer.nytimes.com/docs/rss-api/1/overview
    feeds = [
        # to filter out all opinions from other sections first
        'https://rss.nytimes.com/services/xml/rss/nyt/Opinion.xml',
        'https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml',
        'https://rss.nytimes.com/services/xml/rss/nyt/World.xml',
        'https://rss.nytimes.com/services/xml/rss/nyt/US.xml',
        'https://rss.nytimes.com/services/xml/rss/nyt/Business.xml',
        'https://rss.nytimes.com/services/xml/rss/nyt/YourMoney.xml',
        'https://rss.nytimes.com/services/xml/rss/nyt/Science.xml',
        'https://rss.nytimes.com/services/xml/rss/nyt/Climate.xml',
        'https://rss.nytimes.com/services/xml/rss/nyt/Health.xml',
        'https://rss.nytimes.com/services/xml/rss/nyt/Arts.xml',
        'https://www.nytimes.com/services/xml/rss/nyt/Travel.xml',
        'https://rss.nytimes.com/services/xml/rss/nyt/Sports.xml',
    ]

    def get_cover_url(self):
        soup = self.index_to_soup('https://www.frontpages.com/us-newspapers/')
        for img in soup.findAll('img', src=True):
            if 'new-york-times' in img['src']:
                return 'https://www.frontpages.com' + img['src']

    recipe_specific_options = {
        'days': {
            'short': 'Oldest article to download from this news source. In days ',
            'long': 'For example, 0.5, gives you articles from the past 12 hours',
            'default': str(oldest_article),
        },
        'comp': {'short': 'Compress News Images?', 'long': 'enter yes', 'default': 'no'},
        'rev': {
            'short': 'Reverse the order of articles in each feed?',
            'long': 'enter yes',
            'default': 'no',
        },
        'res': {
            'short': (
                'For hi-res images, select a resolution from the following\noptions: '
                'popup, jumbo, mobileMasterAt3x, superJumbo'
            ),
            'long': (
                'This is useful for non e-ink devices, and for a lower file size\nthan '
                'the default, use mediumThreeByTwo440, mediumThreeByTwo225, articleInline.'
            ),
        },
        'cont': {
            'short': 'Get all content?',
            'long': 'enter yes. Includes all articles from all feeds... magazines, books etc.',
            'default': 'no',
        }
    }

    def __init__(self, *args, **kwargs):
        cookie_header = os.environ.get('NYT_COOKIE_HEADER', '').strip()
        username = os.environ.get('NYT_USERNAME', '').strip()
        password = os.environ.get('NYT_PASSWORD', '').strip()
        embedded = os.environ.get('NYT_USE_EMBEDDED', '').strip().lower()
        max_per_feed = os.environ.get('NYT_MAX_ARTICLES_PER_FEED', '').strip()
        include_feeds = os.environ.get('NYT_INCLUDE_FEEDS', '').strip()
        exclude_feeds = os.environ.get('NYT_EXCLUDE_FEEDS', '').strip()
        threads = os.environ.get('NYT_THREADS', '').strip()
        delay_seconds = os.environ.get('NYT_DELAY_SECONDS', '').strip()

        # Avoid mutating class-level feed list shared across recipe instances.
        self.feeds = list(self.feeds)

        if include_feeds:
            include_tokens = [x.strip().lower() for x in include_feeds.split(',') if x.strip()]
            self.feeds = [
                feed for feed in self.feeds
                if any(token in feed.lower() for token in include_tokens)
            ]

        if exclude_feeds:
            exclude_tokens = [x.strip().lower() for x in exclude_feeds.split(',') if x.strip()]
            self.feeds = [
                feed for feed in self.feeds
                if not any(token in feed.lower() for token in exclude_tokens)
            ]

        # Calibre checks subscription credentials during BasicNewsRecipe.__init__.
        # Allow cookie-only auth by providing placeholders when an auth cookie exists.
        self.username = username or ('cookie-auth' if cookie_header else '')
        self.password = password or ('cookie-auth' if cookie_header else '')

        BasicNewsRecipe.__init__(self, *args, **kwargs)

        if embedded in ('yes', 'true', '1'):
            self.use_embedded_content = True
        elif embedded in ('no', 'false', '0'):
            self.use_embedded_content = False

        # When Playwright fallback is enabled, use get_obfuscated_article so Calibre
        # routes every article fetch through our Playwright-based downloader instead
        # of mechanize (which NYT blocks before preprocess_raw_html is ever called).
        pw_enabled = os.environ.get('NYT_PLAYWRIGHT_FALLBACK', '').strip().lower() in ('yes', 'true', '1')
        if pw_enabled:
            self.articles_are_obfuscated = True

        if max_per_feed:
            try:
                n = int(max_per_feed)
                if n > 0:
                    self.max_articles_per_feed = n
            except Exception:
                pass

        if threads:
            try:
                n_threads = int(threads)
                if n_threads > 0:
                    self.simultaneous_downloads = n_threads
            except Exception:
                pass

        if delay_seconds:
            try:
                d = int(delay_seconds)
                if d >= 0:
                    self.delay = d
            except Exception:
                pass

        d = self.recipe_specific_options.get('days')
        if d and isinstance(d, str):
            self.oldest_article = float(d)
        r = self.recipe_specific_options.get('rev')
        if r and isinstance(r, str):
            if r.lower() == 'yes':
                self.reverse_article_order = True
        c = self.recipe_specific_options.get('comp')
        if c and isinstance(c, str):
            if c.lower() == 'yes':
                self.compress_news_images = True
        a = self.recipe_specific_options.get('cont')
        if a and isinstance(a, str):
            if a.lower() == 'yes':
                self.feeds.extend(
                    [
                        'https://rss.nytimes.com/services/xml/rss/nyt/Technology.xml',
                        'https://rss.nytimes.com/services/xml/rss/nyt/FashionandStyle.xml',
                        'https://rss.nytimes.com/services/xml/rss/nyt/tmagazine.xml',
                        'https://rss.nytimes.com/services/xml/rss/nyt/books.xml',
                        'https://www.nytimes.com/services/xml/rss/nyt/Travel.xml',
                        'https://rss.nytimes.com/services/xml/rss/nyt/well.xml',
                        'https://rss.nytimes.com/services/xml/rss/nyt/Magazine.xml',
                        'http://nytimes.com/timeswire/feeds/',
                    ]
                )

    extra_css = '''
        .byl, .time { font-size:small; color:#202020; }
        .cap { font-size:small; text-align:center; }
        .cred { font-style:italic; font-size:small; }
        em, blockquote { color: #202020; }
        .sc { font-variant: small-caps; }
        .lbl { font-size:small; color:#404040; }
        img { display:block; margin:0 auto; }
    '''

    @property
    def nyt_parser(self):
        ans = getattr(self, '_nyt_parser', None)
        if ans is None:
            from calibre.live import load_module

            self._nyt_parser = ans = load_module('calibre.web.site_parsers.nytimes')
        return ans

    def get_nyt_page(self, url, skip_wayback=False):
        if use_wayback_machine and not skip_wayback:
            from calibre import browser

            return self.nyt_parser.download_url(url, browser())
        return self.index_to_soup(url, raw=True)

    articles_are_obfuscated = use_wayback_machine

    def get_obfuscated_article(self, url):
        from calibre.ptempfile import PersistentTemporaryFile

        # Playwright mode: use headless Firefox to render the full article page.
        # This produces proper Next.js __NEXT_DATA__ that the NYT parser can extract.
        if os.environ.get('NYT_PLAYWRIGHT_FALLBACK', '').strip().lower() in ('yes', 'true', '1'):
            self.log('Playwright: fetching %s' % url)
            pw_html = self._fetch_with_playwright(url)
            if pw_html:
                with PersistentTemporaryFile(suffix='.html') as tf:
                    tf.write(pw_html.encode('utf-8'))
                return tf.name
            self.log.warn('Playwright fetch failed for %s, falling back to mechanize' % url)

        # Wayback machine mode (original behaviour).
        if use_wayback_machine:
            with PersistentTemporaryFile() as tf:
                tf.write(self.get_nyt_page(url))
            return tf.name

        # Plain mechanize fallback.
        try:
            raw = self.index_to_soup(url, raw=True)
        except Exception as e:
            self.log.warn('Mechanize fetch failed for %s: %s' % (url, e))
            raw = b'<html><body><p>Article could not be downloaded.</p></body></html>'
        with PersistentTemporaryFile(suffix='.html') as tf:
            tf.write(raw if isinstance(raw, bytes) else raw.encode('utf-8'))
        return tf.name

    # Minimum characters of extracted HTML required to consider content adequate.
    _PLAYWRIGHT_THRESHOLD = 1500

    def preprocess_raw_html(self, raw_html, url):
        """Extract clean article HTML using the NYT site parser.

        When Playwright mode is active, raw_html is the full JS-rendered page
        which includes __NEXT_DATA__, so the parser should succeed.  If it
        doesn't (e.g. paywalled or error page), we fall back to the raw HTML
        so Calibre can still produce something rather than an empty article.
        """
        try:
            extracted = self.nyt_parser.extract_html(self.index_to_soup(raw_html), url)
            if extracted and len(extracted.strip()) >= self._PLAYWRIGHT_THRESHOLD:
                return extracted
            if extracted and extracted.strip():
                self.log.warn(
                    'NYT parser returned short content (%d chars) for %s'
                    % (len(extracted.strip()), url)
                )
                return extracted
        except Exception as e:
            self.log.warn('NYT parser error for %s: %s' % (url, e))
        return raw_html

    def _fetch_with_playwright(self, url):
        import subprocess

        # Script path is passed via env var to avoid __file__ being unavailable in Calibre runtime.
        script = os.environ.get('NYT_PLAYWRIGHT_SCRIPT_PATH', '').strip()
        if not script:
            self.log.warn('Playwright: NYT_PLAYWRIGHT_SCRIPT_PATH env var is not set')
            return None
        if not os.path.exists(script):
            self.log.warn('Playwright fetcher script not found: %s' % script)
            return None

        # Use NYT_PYTHON_PATH when set (system Python with playwright installed).
        python = os.environ.get('NYT_PYTHON_PATH', '').strip() or 'python'
        env = dict(os.environ)

        result = subprocess.run(
            [python, script, url],
            capture_output=True,
            timeout=60,
            env=env,
        )
        if result.returncode != 0:
            self.log.warn(
                'Playwright fetcher exit %d for %s: %s'
                % (
                    result.returncode,
                    url,
                    result.stderr.decode('utf-8', errors='replace')[:400],
                )
            )
            return None
        html = result.stdout.decode('utf-8', errors='replace')
        self.log('Playwright fetched %d chars from %s' % (len(html), url))
        return html

    def get_browser(self, *args, **kwargs):
        kwargs['user_agent'] = (
            'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 '
            '(KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36'
        )
        br = BasicNewsRecipe.get_browser(self, *args, **kwargs)

        br.addheaders = [h for h in br.addheaders if h[0].lower() not in {'accept-language', 'referer', 'dnt'}]
        br.addheaders.extend([
            ('Accept-Language', 'en-US,en;q=0.9'),
            ('Referer', 'https://www.nytimes.com/'),
            ('DNT', '1'),
        ])

        # NYT authentication is most reliable with an authenticated cookie header.
        cookie_header = os.environ.get('NYT_COOKIE_HEADER', '').strip()
        if cookie_header:
            br.addheaders = [h for h in br.addheaders if h[0].lower() != 'cookie']
            br.addheaders.append(('Cookie', cookie_header))

        username = os.environ.get('NYT_USERNAME', '').strip()
        password = os.environ.get('NYT_PASSWORD', '').strip()
        if username and password:
            self.log('NYT credentials detected; cookie-based auth may still be required for full access.')

        return br

    def preprocess_html(self, soup):
        w = self.recipe_specific_options.get('res')
        if w and isinstance(w, str):
            res = '-' + w
            for img in soup.findAll('img', attrs={'src': True}):
                if '-article' in img['src']:
                    ext = img['src'].split('?')[0].split('.')[-1]
                    img['src'] = img['src'].rsplit('-article', 1)[0] + res + '.' + ext
        for c in soup.findAll('div', attrs={'class': 'cap'}):
            for p in c.findAll(['p', 'div']):
                p.name = 'span'
        return soup

    def get_article_url(self, article):
        url = BasicNewsRecipe.get_article_url(self, article)
        # you can remove '|/espanol/' from code below to include spanish articles.
        if not re.search(r'/video/|/live/|/athletic/|/espanol/|/card/', url):
            return url
        self.log('\tSkipped URL: ', url)
        return None


calibre_most_common_ua = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36'